# Copy to .env.local and fill in from Supabase: Project Settings -> API Keys / Data API.
# Leave empty to use the bundled catalog snapshot (lib/catalog/seed-data.ts) locally.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). Never put the secret / service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Checkout (server only; never prefix these with NEXT_PUBLIC_) ---
# Supabase secret key (sb_secret_...): saves orders. Without it, local dev keeps orders in memory.
SUPABASE_SECRET_KEY=
# Shows the Checkout button in the laundry basket.
CHECKOUT_ENABLED=true
# This site's public https origin, registered with PAYable (e.g. https://staging.example.com). Defaults to the request origin.
SITE_URL=
# mock (fake gateway inside this app, local only) | sandbox | live
PAYABLE_MODE=mock
# From PAYable (sandbox keys for sandbox, live keys for live). Not needed for mock.
PAYABLE_MERCHANT_KEY=
PAYABLE_MERCHANT_TOKEN=
PAYABLE_BUSINESS_KEY=
PAYABLE_BUSINESS_TOKEN=

# Protects the daily clean-up of custom tee designs (/api/cron/clean-designs). Vercel sends it automatically; any long random string.
CRON_SECRET=

# Launch lock: anything but "true" shows only the coming-soon page at / (admin keeps working).
# Set STORE_OPEN=true in Vercel and redeploy to open the shop.
STORE_OPEN=
